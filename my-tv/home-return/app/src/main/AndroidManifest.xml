<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions besides binding as an accessibility service: no INTERNET, no storage, no settings access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:allowBackup="false">
        <!-- directBootAware so Android 11 still binds it after a reboot (it reads no stored data). -->
        <service
            android:name=".HomeReturnService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_return" />
        </service>
    </application>
</manifest>
